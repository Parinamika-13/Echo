# ============================================================
# ECHO Environment Configuration Example
# ============================================================

# Database (Default: SQLite for local dev; PostgreSQL supported)
DATABASE_URL=sqlite:///./echo_backend.db

# Message Broker / Cache (Future integration)
REDIS_URL=

# AI / LLM Providers (Future integration)
OPENAI_API_KEY=
LLM_PROVIDER=

# Vector Database (Future integration)
VECTOR_DB_URL=

# External Data Services (Future integration)
GEOCODING_API_KEY=
SCRAPER_API_KEY=

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
